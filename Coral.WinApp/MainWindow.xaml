<Window x:Class="Coral.WinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coral" Icon="Assets/Coral.png" Height="760" Width="1080" MinHeight="600" MinWidth="820">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/Coral.png" Width="36" Height="36" Margin="0,0,12,0" />
        <TextBlock Text="Coral" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <Border Background="#FF203A52" Padding="16" Margin="0,12,0,0" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="{Binding State}" Foreground="White" FontWeight="Bold" FontSize="20" />
          <TextBlock Text="{Binding Detail}" Foreground="White" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
    <TabControl Grid.Row="1" FontSize="16">
      <TabItem Header="Overview">
        <StackPanel Margin="20">
          <TextBlock Text="Service status" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Margin="0,12,0,0" Text="Queue depth" /><TextBlock Text="{Binding QueueDepth}" FontSize="28" />
          <TextBlock Margin="0,12,0,18" Text="{Binding LastUpdated, StringFormat=Last updated: {0}}" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Printers">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="Kitchen printer" FontSize="22" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,28">
            <Button Content="Test connection" Command="{Binding TestKitchenConnectionCommand}" />
            <Button Content="Print test receipt" Command="{Binding TestKitchenPrintCommand}" />
          </StackPanel>
          <TextBlock Text="Register printer" FontSize="22" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
            <Button Content="Test connection" Command="{Binding TestRegisterConnectionCommand}" />
            <Button Content="Print test receipt" Command="{Binding TestRegisterPrintCommand}" />
          </StackPanel>
          <TextBlock Text="Cash-drawer testing will be enabled once the service management pipe supports audited, confirmed drawer operations." TextWrapping="Wrap" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Diagnostics">
        <StackPanel Margin="20"><TextBlock Text="Diagnostics" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,12,0,0" Text="Redacted logs and diagnostic export will appear here when logs.tail is available from the local management service." TextWrapping="Wrap" /></StackPanel>
      </TabItem>
      <TabItem Header="Configuration">
        <StackPanel Margin="20"><TextBlock Text="Configuration" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,12,0,0" Text="Configuration editing requires an elevated administrator connection and will be enabled with config.validate and config.apply service commands." TextWrapping="Wrap" /></StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
