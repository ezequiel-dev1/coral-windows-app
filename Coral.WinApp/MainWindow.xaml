<Window x:Class="Coral.WinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coral" Icon="Assets/CoralBrandIcon.png" Height="460" Width="560" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="{StaticResource CoralMistBrush}" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="White" Foreground="{StaticResource CoralInkBrush}" Padding="6,3">
      <MenuItem Header="Coral">
        <MenuItem Header="Ocultar en la bandeja" Click="HideToTray_Click" />
        <Separator />
        <MenuItem Header="Salir" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="Actualizaciones">
        <MenuItem x:Name="InstallLatestMenuItem" Header="Instalar la versión más reciente" Click="InstallLatest_Click" />
      </MenuItem>
    </Menu>

    <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel Orientation="Horizontal">
        <Border Width="36" Height="36" Background="{StaticResource CoralTealBrush}" CornerRadius="8">
          <Image Source="Assets/CoralBrandIcon.png" Margin="4" Stretch="Uniform" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Configuración de impresoras" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CoralInkBrush}" />
          <TextBlock Text="Coral está activo en el área de notificación." Margin="0,2,0,0" FontSize="12" Foreground="#7A7572" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="0,16,0,0" Background="#E4E8F5" BorderBrush="#C2C7DC" BorderThickness="1" CornerRadius="8" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="●" FontSize="18" Foreground="{StaticResource CoralSuccessBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="9,0,0,0">
          <TextBlock Text="{Binding State}" FontWeight="SemiBold" Foreground="{StaticResource CoralInkBrush}" />
          <TextBlock Text="{Binding Detail}" Margin="0,1,0,0" FontSize="12" Foreground="#7A7572" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <Border Style="{StaticResource PageCardStyle}" Padding="14" Margin="0,0,0,10">
        <Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="IMPRESORA DE COCINA" FontSize="10" FontWeight="SemiBold" Foreground="#7A7572" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Cocina" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CoralInkBrush}" />
                <Border Margin="9,1,0,0" Background="#F3F4F6" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding KitchenStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding KitchenStatusColor}" /></Border>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Probar conexión" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestKitchenConnectionCommand}" />
              <Button Content="Imprimir prueba" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding TestKitchenPrintCommand}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Style="{StaticResource PageCardStyle}" Padding="14">
        <Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="IMPRESORA DE CAJA" FontSize="10" FontWeight="SemiBold" Foreground="#7A7572" />
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="Caja" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CoralInkBrush}" />
                <Border Margin="9,1,0,0" Background="#F3F4F6" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding RegisterStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RegisterStatusColor}" /></Border>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Probar conexión" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestRegisterConnectionCommand}" />
              <Button Content="Imprimir prueba" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding TestRegisterPrintCommand}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>
    </Grid>
  </DockPanel>
</Window>
