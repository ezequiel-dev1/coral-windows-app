<Application x:Class="Coral.WinApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:ModernWpf.Controls;assembly=ModernWpf.Controls"
             xmlns:resources="clr-namespace:ModernWpf.Controls;assembly=ModernWpf">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemeResources RequestedTheme="Light" AccentColor="#3D4F9B" />
        <resources:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>

      <!-- Coral Admin palette: royal blue primary with a warm salmon accent. -->
      <Color x:Key="CoralInkColor">#3D4F9B</Color>
      <Color x:Key="CoralTealColor">#3D4F9B</Color>
      <Color x:Key="CoralTealDarkColor">#344585</Color>
      <Color x:Key="CoralMistColor">#EAE7E4</Color>
      <Color x:Key="CoralLineColor">#DDD9D6</Color>
      <Color x:Key="CoralSuccessColor">#4F8469</Color>
      <Color x:Key="CoralCoralColor">#E48664</Color>

      <SolidColorBrush x:Key="CoralInkBrush" Color="{StaticResource CoralInkColor}" />
      <SolidColorBrush x:Key="CoralTealBrush" Color="{StaticResource CoralTealColor}" />
      <SolidColorBrush x:Key="CoralTealDarkBrush" Color="{StaticResource CoralTealDarkColor}" />
      <SolidColorBrush x:Key="CoralMistBrush" Color="{StaticResource CoralMistColor}" />
      <SolidColorBrush x:Key="CoralLineBrush" Color="{StaticResource CoralLineColor}" />
      <SolidColorBrush x:Key="CoralSuccessBrush" Color="{StaticResource CoralSuccessColor}" />
      <SolidColorBrush x:Key="CoralCoralBrush" Color="{StaticResource CoralCoralColor}" />

      <Style x:Key="PageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource CoralLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="28" />
      </Style>

      <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Background" Value="{StaticResource CoralTealBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource CoralTealBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource CoralInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CoralLineBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
